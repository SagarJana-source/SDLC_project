{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc-agentic-framework/prototype-artifacts.schema.json",
  "title": "SDLC Agentic Framework Prototype Artifact",
  "type": "object",
  "required": ["id", "type", "version", "status", "createdAt", "createdBy", "sourceIds", "requirementIds"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "awaiting_approval", "approved", "rejected", "complete", "failed"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "createdBy": {"type": "string", "minLength": 1},
    "sourceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requirementIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "evidenceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
